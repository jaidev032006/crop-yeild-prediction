FLASK_ENV=development
FLASK_DEBUG=True
SECRET_KEY=agrismart_secure_random_key_production_2026

# Server Network Configuration
SERVER_HOST=0.0.0.0
SERVER_PORT=5000

# Database Configuration (Relative to agrismart directory)
